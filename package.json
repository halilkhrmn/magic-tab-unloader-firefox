{
  "name": "magic-tab-unloader",
  "version": "0.4.2",
  "private": true,
  "description": "Firefox extension that automatically unloads idle tabs.",
  "license": "GPL-3.0-only",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "icons": "sh assets/export-icons.sh"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "web-ext-artifacts",
    "ignoreFiles": [
      "tests",
      "docs",
      "assets",
      ".github",
      "package.json",
      "package-lock.json",
      "README.md",
      "PRIVACY.md",
      "node_modules",
      "web-ext-artifacts",
      ".gitignore"
    ]
  }
}
